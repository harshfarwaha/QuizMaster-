GEMINI_API_KEY=your-gemini-api-key-goes-here
# Optional: one OpenRouter key or several comma-separated keys for automatic fallback when Gemini is limited.
OPENROUTER_API_KEY=your-openrouter-api-key-goes-here
OPENROUTER_API_KEYS=your-openrouter-key-1,your-openrouter-key-2
OPENROUTER_MODEL=google/gemini-2.5-flash
APP_PUBLIC_URL=https://your-site.example.com
APP_NAME=QuizMaster
